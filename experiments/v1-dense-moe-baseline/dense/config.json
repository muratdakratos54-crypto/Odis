{
  "model": {
    "vocab_size": 8192,
    "max_seq_len": 512,
    "d_model": 512,
    "n_layer": 8,
    "n_head": 8,
    "ffn_hidden": 1408,
    "rope_theta": 10000.0,
    "dropout": 0.0,
    "tie_embeddings": true
  },
  "train": {
    "run_name": "dense",
