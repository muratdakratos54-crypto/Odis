    "max_steps": 3000,
    "lr": 0.001,
    "min_lr": 0.0001,
    "warmup_steps": 200,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_interval": 250,
    "eval_iters": 40,
    "log_interval": 25,
    "sample_tokens": 120,
    "seed": 1337,
    "dtype": "bfloat16",
    "compile": false,
    "resume": false,
    "vram_limit_frac": 0.92
